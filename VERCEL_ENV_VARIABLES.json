{
  "env": [
    {
      "key": "FLASK_CONFIG",
      "value": "production",
      "target": "production"
    },
    {
      "key": "SECRET_KEY",
      "value": "your-secret-key-here",
      "target": "production"
    },
    {
      "key": "JWT_SECRET_KEY",
      "value": "your-jwt-secret-key-here",
      "target": "production"
    },
    {
      "key": "GEMINI_API_KEY",
      "value": "your-gemini-key-here",
      "target": "production"
    },
    {
      "key": "GROQ_API_KEY",
      "value": "your-groq-key-here",
      "target": "production"
    },
    {
      "key": "NEXT_PUBLIC_API_URL",
      "value": "/api",
      "target": "production"
    },
    {
      "key": "DATABASE_URL",
      "value": "sqlite:///hospital.db",
      "target": "production"
    },
    {
      "key": "MAIL_SERVER",
      "value": "smtp.gmail.com",
      "target": "production"
    },
    {
      "key": "MAIL_PORT",
      "value": "587",
      "target": "production"
    },
    {
      "key": "MAIL_USE_TLS",
      "value": "true",
      "target": "production"
    },
    {
      "key": "MAX_CONTENT_LENGTH",
      "value": "16777216",
      "target": "production"
    }
  ]
}
