{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "ignore": [
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    "uploads",
    "logs",
    "backups",
    "scripts",
    "tests"
  ]
}