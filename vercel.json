{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next@latest"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python@latest"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "ignore": [
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    "node_modules",
    "uploads",
    "logs",
    "backups",
    "scripts",
    "tests"
  ]
}